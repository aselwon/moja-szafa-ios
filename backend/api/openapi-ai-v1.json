{
  "openapi": "3.1.0",
  "info": {
    "title": "Moja Szafa AI runtime API",
    "version": "1.0.0",
    "description": "Server-derived owner, budgeted durable enqueue, and private validated result retrieval. Keep operation_id and full payload unchanged for replay. Result is null unless succeeded. No raw prompts, credentials or telemetry in responses."
  },
  "paths": {
    "/rest/v1/rpc/api_v1_generate_outfits": {
      "post": {
        "operationId": "api_v1_generate_outfits",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Content-Profile",
            "in": "header",
            "required": true,
            "schema": {
              "const": "app"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "operation_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "pinned_garment_id": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "uuid"
                      },
                      "preferences": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "colors": {
                            "type": "array",
                            "maxItems": 13,
                            "uniqueItems": true,
                            "items": {
                              "enum": [
                                "black",
                                "white",
                                "gray",
                                "beige",
                                "brown",
                                "red",
                                "orange",
                                "yellow",
                                "green",
                                "blue",
                                "purple",
                                "pink",
                                "other"
                              ]
                            }
                          },
                          "seasons": {
                            "type": "array",
                            "maxItems": 4,
                            "uniqueItems": true,
                            "items": {
                              "enum": [
                                "spring",
                                "summer",
                                "autumn",
                                "winter"
                              ]
                            }
                          }
                        },
                        "required": [
                          "colors",
                          "seasons"
                        ]
                      },
                      "occasion": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "formality": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 1,
                            "maximum": 5
                          }
                        },
                        "required": [
                          "formality"
                        ]
                      },
                      "weather": {
                        "oneOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "source",
                              "temperature_celsius"
                            ],
                            "properties": {
                              "source": {
                                "const": "manual"
                              },
                              "temperature_celsius": {
                                "type": "number",
                                "minimum": -80,
                                "maximum": 60
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "source",
                              "temperature_celsius",
                              "valid_until"
                            ],
                            "properties": {
                              "source": {
                                "const": "forecast"
                              },
                              "temperature_celsius": {
                                "type": "number",
                                "minimum": -80,
                                "maximum": 60
                              },
                              "valid_until": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Forecast validity epoch seconds. Expired hints are ignored at dispatch."
                              }
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "operation_id",
                      "count",
                      "pinned_garment_id",
                      "preferences",
                      "occasion"
                    ]
                  }
                },
                "required": [
                  "request"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed owner-scoped success or error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "data": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "job_id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "queued",
                                "running",
                                "succeeded",
                                "failed",
                                "cancelled",
                                "dead_letter"
                              ]
                            }
                          },
                          "required": [
                            "job_id",
                            "status"
                          ]
                        },
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "required": [
                        "data",
                        "request_id"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "error": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "code": {
                              "enum": [
                                "unauthorized",
                                "account_unavailable",
                                "ai_disabled",
                                "quota_exceeded",
                                "consent_required",
                                "validation_failed",
                                "internal_error",
                                "not_found"
                              ]
                            },
                            "message": {
                              "type": "string"
                            },
                            "request_id": {
                              "type": "string",
                              "format": "uuid"
                            }
                          },
                          "required": [
                            "code",
                            "message",
                            "request_id"
                          ]
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/rpc/api_v1_job_result": {
      "post": {
        "operationId": "api_v1_job_result",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Content-Profile",
            "in": "header",
            "required": true,
            "schema": {
              "const": "app"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "job_id": {
                        "type": "string",
                        "format": "uuid"
                      }
                    },
                    "required": [
                      "job_id"
                    ]
                  }
                },
                "required": [
                  "request"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Typed owner-scoped success or error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "data": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "job_id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "kind": {
                              "const": "outfit_generation"
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "queued",
                                "running",
                                "succeeded",
                                "failed",
                                "cancelled",
                                "dead_letter"
                              ]
                            },
                            "error_code": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "result": {
                              "oneOf": [
                                {
                                  "type": "null"
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "outfits": {
                                      "type": "array",
                                      "maxItems": 10,
                                      "items": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {
                                          "garment_ids": {
                                            "type": "array",
                                            "minItems": 1,
                                            "maxItems": 40,
                                            "uniqueItems": true,
                                            "items": {
                                              "type": "string",
                                              "format": "uuid"
                                            }
                                          },
                                          "rationale": {
                                            "type": "string",
                                            "maxLength": 1000
                                          },
                                          "complete": {
                                            "type": "boolean"
                                          },
                                          "missing_categories": {
                                            "type": "array",
                                            "items": {
                                              "enum": [
                                                "top",
                                                "bottom",
                                                "shoes"
                                              ]
                                            }
                                          }
                                        },
                                        "required": [
                                          "garment_ids",
                                          "rationale",
                                          "complete",
                                          "missing_categories"
                                        ]
                                      }
                                    },
                                    "shortfall_reason": {
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "outfits",
                                    "shortfall_reason"
                                  ]
                                }
                              ]
                            }
                          },
                          "required": [
                            "job_id",
                            "kind",
                            "status",
                            "error_code",
                            "result"
                          ]
                        },
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "required": [
                        "data",
                        "request_id"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "error": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "code": {
                              "enum": [
                                "unauthorized",
                                "account_unavailable",
                                "ai_disabled",
                                "quota_exceeded",
                                "consent_required",
                                "validation_failed",
                                "internal_error",
                                "not_found"
                              ]
                            },
                            "message": {
                              "type": "string"
                            },
                            "request_id": {
                              "type": "string",
                              "format": "uuid"
                            }
                          },
                          "required": [
                            "code",
                            "message",
                            "request_id"
                          ]
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
