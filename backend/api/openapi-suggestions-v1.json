{
  "openapi": "3.1.0",
  "info": {
    "title": "Moja Szafa suggestion API",
    "version": "1.0.0",
    "description": "Owner-scoped validated suggestions and idempotent outfit save. Availability is rechecked while saving; completed replay preserves the original response."
  },
  "paths": {
    "/rest/v1/rpc/api_v1_latest_suggestions": {
      "post": {
        "operationId": "api_v1_latest_suggestions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Content-Profile",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "app"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "request"
                ],
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "type": "object",
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Latest completed validated outfit result, or null when absent. No raw input or telemetry.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "data",
                        "request_id"
                      ],
                      "properties": {
                        "data": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "outfits": {
                                  "type": "array",
                                  "maxItems": 10,
                                  "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                      "garment_ids": {
                                        "type": "array",
                                        "minItems": 1,
                                        "maxItems": 40,
                                        "uniqueItems": true,
                                        "items": {
                                          "type": "string",
                                          "format": "uuid"
                                        }
                                      },
                                      "rationale": {
                                        "type": "string",
                                        "maxLength": 1000
                                      },
                                      "complete": {
                                        "type": "boolean"
                                      },
                                      "missing_categories": {
                                        "type": "array",
                                        "items": {
                                          "enum": [
                                            "top",
                                            "bottom",
                                            "shoes"
                                          ]
                                        }
                                      }
                                    },
                                    "required": [
                                      "garment_ids",
                                      "rationale",
                                      "complete",
                                      "missing_categories"
                                    ]
                                  }
                                },
                                "shortfall_reason": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                }
                              },
                              "required": [
                                "outfits",
                                "shortfall_reason"
                              ]
                            }
                          ]
                        },
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Gateway or infrastructure HTTP failure; may not contain application JSON. Preserve X-Request-ID if present."
          }
        },
        "summary": "Save manual outfit atomically with replay and version checking"
      }
    },
    "/rest/v1/rpc/api_v1_save_suggestion": {
      "post": {
        "operationId": "api_v1_save_suggestion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Content-Profile",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "app"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "request"
                ],
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "$ref": "#/components/schemas/SaveOutfit"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application success OR structured domain error; inspect error before data. Replay returns original response including request_id.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OutfitSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Gateway or infrastructure HTTP failure; may not contain application JSON. Preserve X-Request-ID if present."
          }
        },
        "summary": "Save manual outfit atomically with replay and version checking"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthorized",
                  "account_unavailable",
                  "validation_failed",
                  "version_conflict",
                  "idempotency_conflict",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "SaveOutfit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationID",
          "id",
          "baseVersion",
          "name",
          "favorite",
          "garmentIDs"
        ],
        "properties": {
          "operationID": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "baseVersion": {
            "type": "integer",
            "minimum": 0,
            "description": "0 creates; positive values must match current version."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "favorite": {
            "type": "boolean"
          },
          "garmentIDs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "OutfitSuccess": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Outfit"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Outfit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "name",
          "favorite",
          "garments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "favorite": {
            "type": "boolean"
          },
          "garments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WardrobeItem"
            }
          }
        }
      },
      "WardrobeItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "availability": {
            "type": "string"
          },
          "priceGrosz": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "imageID": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "brand": {
            "type": [
              "string",
              "null"
            ]
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "availability",
          "priceGrosz",
          "imageID",
          "brand",
          "colors",
          "seasons",
          "archived"
        ]
      }
    }
  }
}
