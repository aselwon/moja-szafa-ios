{
  "openapi":"3.1.0",
  "info":{"title":"AI disclosure and consent","version":"1.0.0"},
  "paths":{
    "/rest/v1/rpc/api_v1_ai_consent":{"post":{
      "operationId":"api_v1_ai_consent",
