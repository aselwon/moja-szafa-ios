      "responses":{"200":{"description":"Current disclosure/choice or validation error","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/Success"},{"$ref":"#/components/schemas/Failure"}]}}}},"401":{"description":"Current authenticated session required"}}
