{
  "openapi": "3.1.0",
  "info": {
    "title": "Moja Szafa API foundation",
    "version": "1.0.0",
    "description": "Implemented T009 RPC surface. Cursor is last UUID in ascending UUID order, scoped by authenticated owner; not a snapshot. Null base_version creates, positive base_version updates. Keep operation_id and entire body unchanged after timeout. Reject unknown input fields. Successful mutations and replay records commit atomically. Subsequent product APIs extend this versioned foundation in their feature tasks."
  },
  "paths": {
    "/rest/v1/rpc/api_v1_save_garment": {
      "post": {
        "operationId": "api_v1_save_garment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Content-Profile",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "app"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "request"
                ],
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "$ref": "#/components/schemas/SaveGarment"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application success OR structured domain error; inspect error before data. Replay returns original response including request_id.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/GarmentSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Gateway or infrastructure HTTP failure; may not contain application JSON. Preserve X-Request-ID if present."
          }
        }
      }
    },
    "/rest/v1/rpc/api_v1_list_garments": {
      "post": {
        "operationId": "api_v1_list_garments",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Content-Profile",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "app"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "request"
                ],
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "$ref": "#/components/schemas/PageRequest"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application success OR structured domain error; inspect error before data. Replay returns original response including request_id.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/GarmentPageSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Gateway or infrastructure HTTP failure; may not contain application JSON. Preserve X-Request-ID if present."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "GarmentFields": {
        "type": "object",
        "required": [
          "name",
          "category",
          "price_grosz",
          "availability"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "shoes",
              "dress",
              "jumpsuit",
              "outerwear",
              "accessory",
              "other"
            ]
          },
          "price_grosz": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "laundry",
              "unavailable"
            ]
          }
        }
      },
      "Garment": {
        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "category",
          "price_grosz",
          "availability"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "shoes",
              "dress",
              "jumpsuit",
              "outerwear",
              "accessory",
              "other"
            ]
          },
          "price_grosz": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "laundry",
              "unavailable"
            ]
          }
        }
      },
      "SaveGarment": {
        "type": "object",
        "required": [
          "operation_id",
          "garment_id",
          "base_version",
          "garment"
        ],
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "garment_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "garment": {
            "$ref": "#/components/schemas/GarmentFields"
          }
        }
      },
      "PageRequest": {
        "type": "object",
        "required": [
          "limit",
          "cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "GarmentPage": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Garment"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthorized",
                  "account_unavailable",
                  "validation_failed",
                  "version_conflict",
                  "idempotency_conflict",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "GarmentSuccess": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Garment"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GarmentPageSuccess": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/GarmentPage"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
