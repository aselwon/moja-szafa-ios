              "type": "string",
              "enum": [
                "black",
                "white",
                "gray",
                "beige",
                "brown",
                "red",
                "orange",
                "yellow",
                "green",
                "blue",
                "purple",
                "pink",
                "other"
              ]
            }
          },
          "seasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "spring",
                "summer",
                "autumn",
                "winter"
              ]
            }
          },
          "pattern": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "formality": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
