  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "GarmentFields": {
        "type": "object",
        "required": [
          "name",
          "category",
          "price_grosz",
          "availability"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "shoes",
              "dress",
              "jumpsuit",
              "outerwear",
              "accessory",
              "other"
            ]
          },
          "price_grosz": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "laundry",
              "unavailable"
            ]
          }
        }
      },
      "Garment": {
        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "category",
          "price_grosz",
          "availability"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "shoes",
              "dress",
              "jumpsuit",
              "outerwear",
              "accessory",
              "other"
            ]
          },
          "price_grosz": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "laundry",
              "unavailable"
            ]
          }
        }
      },
      "SaveGarment": {
        "type": "object",
        "required": [
          "operation_id",
          "garment_id",
          "base_version",
          "garment"
        ],
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "garment_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "garment": {
            "$ref": "#/components/schemas/GarmentFields"
          }
        }
      },
      "PageRequest": {
        "type": "object",
        "required": [
          "limit",
          "cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "GarmentPage": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Garment"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthorized",
                  "account_unavailable",
                  "validation_failed",
                  "version_conflict",
                  "idempotency_conflict",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "GarmentSuccess": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Garment"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GarmentPageSuccess": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/GarmentPage"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "attempts",
          "error_code"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image_analysis",
              "outfit_generation",
              "replacement",
              "trip",
              "purchase_fit"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "dead_letter"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "JobPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "JobPageSuccess": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/JobPage"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SyncGarment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "deleted",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "deleted": {
            "type": "boolean"
          },
          "fields": {
            "$ref": "#/components/schemas/GarmentFields"
          }
        }
      },
      "SyncWear": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "deleted",
          "wornOn",
          "timezone",
          "garmentIDs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "deleted": {
            "type": "boolean"
          },
          "wornOn": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string"
          },
          "garmentIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true,
            "maxItems": 100
          }
        }
      },
      "SaveWear": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationID",
          "wear"
        ],
        "properties": {
          "operationID": {
            "type": "string",
            "format": "uuid"
          },
          "wear": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SyncWear"
              },
              {
                "properties": {
                  "version": {
                    "const": 0
                  },
                  "deleted": {
                    "const": false
                  },
                  "garmentIDs": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      },
      "SyncSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "garments",
          "wears",
          "accountID"
        ],
        "properties": {
          "garments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncGarment"
            }
          },
          "wears": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncWear"
            }
          },
          "accountID": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SnapshotRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "SyncWearSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SyncWear"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SyncSnapshotSuccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SyncSnapshot"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
