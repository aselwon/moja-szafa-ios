  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "GarmentFields": {
        "type": "object",
        "required": [
          "name",
          "category",
          "price_grosz",
          "availability"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "shoes",
              "dress",
              "jumpsuit",
              "outerwear",
              "accessory",
              "other"
            ]
          },
          "price_grosz": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "laundry",
              "unavailable"
            ]
          },
          "archived": {
            "type": "boolean",
            "description": "Independent of availability. Omission preserves current archive state on update."
          },
          "metadata": {
            "$ref": "#/components/schemas/GarmentMetadata",
            "description": "Full import form attributes. Omission preserves existing metadata on edits by older clients."
          }
        }
      },
      "Garment": {
        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "category",
          "price_grosz",
          "availability"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "category": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "shoes",
              "dress",
              "jumpsuit",
              "outerwear",
              "accessory",
              "other"
            ]
          },
          "price_grosz": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "laundry",
              "unavailable"
            ]
          },
          "archived": {
            "type": "boolean",
            "description": "Independent of availability. Omission preserves current archive state on update."
          }
        }
      },
      "SaveGarment": {
        "type": "object",
        "required": [
          "operation_id",
          "garment_id",
          "base_version",
          "garment"
        ],
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "garment_id": {
            "type": "string",
            "format": "uuid"
          },
          "base_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              {
                "type": "null"
              }
            ]
          },
          "garment": {
            "$ref": "#/components/schemas/GarmentFields"
          }
        }
      },
      "PageRequest": {
        "type": "object",
        "required": [
          "limit",
          "cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "GarmentPage": {
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Garment"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthorized",
                  "account_unavailable",
                  "validation_failed",
                  "version_conflict",
                  "idempotency_conflict",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "GarmentSuccess": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Garment"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GarmentPageSuccess": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/GarmentPage"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SyncGarment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "deleted",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "deleted": {
            "type": "boolean"
          },
          "fields": {
            "$ref": "#/components/schemas/GarmentFields"
          },
          "metadata": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WardrobeItem"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SyncWear": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "deleted",
          "wornOn",
          "timezone",
          "garmentIDs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "deleted": {
            "type": "boolean"
          },
          "wornOn": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string"
          },
          "garmentIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true,
            "maxItems": 100
          }
        }
      },
      "SaveWear": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationID",
          "wear"
        ],
        "properties": {
          "operationID": {
            "type": "string",
            "format": "uuid"
          },
          "wear": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SyncWear"
              },
              {
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Expected event version; 0 creates, positive values edit. Stale versions and tombstones return version_conflict."
                  },
                  "deleted": {
                    "const": false
                  },
                  "garmentIDs": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      },
