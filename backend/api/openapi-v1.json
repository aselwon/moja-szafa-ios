          "brand": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "purchased_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Calendar date; future dates are rejected by the server."
          }
        }
      }
