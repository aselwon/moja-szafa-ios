{
  "openapi": "3.1.0",
  "info": {
    "title": "Moja Szafa API foundation",
    "version": "1.0.0",
    "description": "Implemented T009 RPC surface. Cursor is last UUID in ascending UUID order, scoped by authenticated owner; not a snapshot. Null base_version creates, positive base_version updates. Keep operation_id and entire body unchanged after timeout. Reject unknown input fields. Successful mutations and replay records commit atomically. Subsequent product APIs extend this versioned foundation in their feature tasks. T010 adds owner-scoped durable job status discovery; clients restart pagination with a null cursor after relaunch. Enqueue/claim/finish are trusted backend functions, not public REST operations."
  },
  "paths": {
    "/rest/v1/rpc/api_v1_save_garment": {
      "post": {
        "operationId": "api_v1_save_garment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Content-Profile",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "app"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "request"
                ],
                "additionalProperties": false,
                "properties": {
                  "request": {
                    "$ref": "#/components/schemas/SaveGarment"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application success OR structured domain error; inspect error before data. Replay returns original response including request_id.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/GarmentSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Gateway or infrastructure HTTP failure; may not contain application JSON. Preserve X-Request-ID if present."
          }
        }
      }
    },
