    "statistics.cpw": {
      "comment": "Wardrobe statistics: cpw",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime cost per wear — lowest first"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koszt założenia za cały czas — od najniższego"
          }
        }
      }
    },
    "statistics.cpwScope": {
      "comment": "Wardrobe statistics: cpwScope",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only known prices and a nonzero wear count are ranked. Zero is a known price. Changing the activity period does not change this cost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranking obejmuje znane ceny i niezerową liczbę noszeń. Zero jest znaną ceną. Zmiana okresu aktywności nie zmienia tego kosztu."
          }
        }
      }
    },
    "statistics.estimated": {
      "comment": "Wardrobe statistics: estimated",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes estimated initial wear history"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwzględnia szacowaną historię początkową"
          }
        }
      }
    },
    "statistics.unused90": {
      "comment": "Wardrobe statistics: unused90",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not worn for at least 90 days"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nienoszone od co najmniej 90 dni"
          }
        }
      }
    },
    "statistics.unknownLastWear": {
      "comment": "Wardrobe statistics: unknownLastWear",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown only when recorded dates or the initial-history boundary establish 90 days of inactivity. Items without enough history are not assumed to be old."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazujemy rzeczy, dla których zapisane daty lub granica historii początkowej potwierdzają 90 dni bez noszenia. Przy braku historii nie zakładamy wieku rzeczy."
          }
        }
      }
    },
    "review.title": {
      "comment": "Wardrobe review: title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wardrobe review"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegląd szafy"
          }
        }
      }
