    "review.rule": {
      "comment": "Wardrobe review: rule",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active garments with at most two recorded wear days in the last 90 days. Recent estimated history is excluded because its wear dates are unknown."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywne rzeczy z najwyżej dwoma zapisanymi dniami noszenia w ostatnich 90 dniach. Niedawna historia szacowana jest pomijana, bo nie znamy dat noszeń."
          }
        }
      }
    },
    "review.local": {
      "comment": "Wardrobe review: local",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep hides an item from this review on this device. It does not change the wardrobe or wear history. You can show kept items and undo this choice."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj ukrywa rzecz z tego przeglądu na tym urządzeniu. Nie zmienia szafy ani historii noszeń. Możesz pokazać zachowane rzeczy i cofnąć wybór."
          }
        }
      }
    },
