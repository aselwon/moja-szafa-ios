    "export.description": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamów prywatne archiwum TAR z danymi JSON i zdjęciami. Pobieranie jest dostępne przez 15 minut i wymaga zalogowania."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a private TAR archive containing JSON data and photos. Download is available for 15 minutes and requires sign-in."
          }
        }
      },
      "comment": "T016 account data export: description"
    },
    "export.synced": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport obejmuje dane zapisane na serwerze. Najpierw zsynchronizuj zmiany offline. Lokalne preferencje profilu i niezapisane szkice nie są częścią tego archiwum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export includes data saved on the server. Sync offline changes first. Device-local profile preferences and unsaved drafts are not part of this archive."
          }
        }
      },
      "comment": "T016 account data export: synced"
    },
