    "export.new": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij nowy eksport"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new export"
          }
        }
      },
      "comment": "T016 account data export: new"
