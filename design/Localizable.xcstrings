    "export.error": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ukończyć eksportu. Sprawdź połączenie i ponów próbę. Po wygaśnięciu rozpocznij nowy eksport. Nowy eksport można zamówić po wygaśnięciu poprzedniego."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export could not be completed. Check your connection and retry. After expiry, start a new export. A new export can be requested once the previous one expires."
          }
        }
      },
      "comment": "T016 account data export: error"
    },
    "export.expired": {
