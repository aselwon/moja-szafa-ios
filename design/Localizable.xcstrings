        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export includes data saved on the server. Sync offline changes first. Device-local profile preferences and unsaved drafts are not part of this archive."
          }
        }
      },
      "comment": "T016 account data export: synced"
    },
    "export.copies": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane przez Ciebie kopie nie wygasają automatycznie. Zachowaj je w bezpiecznym miejscu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies you save do not expire automatically. Keep them in a safe place."
          }
        }
      },
      "comment": "T016 account data export: copies"
    },
    "export.expires": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
