    "privacy.title": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatność i AI"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy and AI"
          }
        }
      },
      "comment": "T015: privacy settings and external AI consent."
    },
    "privacy.manual": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ręczna szafa działa bez zgody na AI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your manual wardrobe works without AI consent."
          }
        }
      },
      "comment": "T015: privacy settings and external AI consent."
    },
    "privacy.inflight": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofnięcie zgody anuluje oczekujące zadania. Danych już wysłanych nie można wycofać. Zmiana wymaga połączenia z serwerem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoking consent cancels pending jobs. Data already sent cannot be recalled. Changes require a server connection."
          }
        }
      },
      "comment": "T015: privacy settings and external AI consent."
    },
    "privacy.unconfigured": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI jest wyłączone do czasu skonfigurowania odbiorcy i informacji o danych."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is disabled until the recipient and data disclosure are configured."
          }
        }
      },
      "comment": "T015: privacy settings and external AI consent."
    },
    "privacy.loadError": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można pobrać ustawień prywatności. Spróbuj ponownie po połączeniu z siecią."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot load privacy settings. Reconnect and retry."
          }
        }
      },
      "comment": "T015: privacy settings and external AI consent."
    },
    "privacy.saveError": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie potwierdzono zapisu. Ponów próbę, aby potwierdzić zmianę na serwerze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save is unconfirmed. Retry to confirm the change on the server."
          }
        }
      },
      "comment": "T015: privacy settings and external AI consent."
    },
