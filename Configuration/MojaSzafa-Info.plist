<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Użyj lokalizacji jednorazowo, aby wybrać miasto dla pogody. Możesz też wpisać miasto ręcznie. / Use your location once to select a weather city. You can also enter a city manually.</string>
	<key>NSCameraUsageDescription</key>
	<string>Zrób zdjęcie ubrania, aby dodać je do swojej szafy. / Take a garment photo to add it to your wardrobe.</string>
	<!-- Custom keys: GENERATE_INFOPLIST_FILE ignores non-Apple INFOPLIST_KEY_* settings, so they live here. -->
	<key>AppEnvironment</key>
	<string>$(APP_ENVIRONMENT)</string>
	<key>BackendBaseURL</key>
	<string>$(BACKEND_BASE_URL)</string>
	<key>AppGroupIdentifier</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>AppURLScheme</key>
	<string>$(APP_URL_SCHEME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array><string>$(APP_URL_SCHEME)</string></array>
		</dict>
	</array>
</dict>
</plist>
