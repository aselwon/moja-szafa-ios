// Public configuration only. No credentials or registered Apple identities assumed.
APP_ENVIRONMENT = dev
APP_GROUP_IDENTIFIER = group.pl.mojaszafa.app.dev
APP_URL_SCHEME = mojaszafa-dev
PRODUCT_BUNDLE_IDENTIFIER = pl.mojaszafa.app.dev
INFOPLIST_KEY_CFBundleDisplayName = Moja Szafa Dev
INFOPLIST_KEY_AppEnvironment = $(APP_ENVIRONMENT)
INFOPLIST_FILE = Configuration/MojaSzafa-Info.plist
// T007/T009 must configure and validate real endpoints before enabling networking.
BACKEND_BASE_URL =
INFOPLIST_KEY_BackendBaseURL = $(BACKEND_BASE_URL)
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Development
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =
#include? "Signing/Dev.local.xcconfig"

CODE_SIGN_ENTITLEMENTS = Configuration/MojaSzafa.entitlements
